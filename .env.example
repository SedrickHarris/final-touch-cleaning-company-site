# =============================================================================
# Final Touch Cleaning Company - Environment Variables Template
# =============================================================================
#
# This file is a TEMPLATE. It must NOT contain real keys.
# Copy this file to .env.local for local development and fill in real values.
#
#   cp .env.example .env.local        (macOS / Linux)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# .env.local is gitignored. Never commit a file containing real keys.
#
# For production, configure these variables in the Cloudflare Pages dashboard:
#   Settings -> Environment variables -> Add variable
#   See docs/site-os/reference/ghl-mvp-env-setup.md for the full setup.
#
# =============================================================================
# IMPORTANT - Public vs Private variables
# =============================================================================
#
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser
# bundle. Any variable without that prefix stays server-only.
#
# Rule of thumb:
#   - Anything secret (API keys, tokens, signing secrets) must NOT be
#     prefixed with NEXT_PUBLIC_. Exposing a private key to the browser
#     leaks it to every visitor and to any LLM crawler that fetches the JS.
#   - Public embed URLs (form embed, calendar embed) are fine as
#     NEXT_PUBLIC_ because the embed URL is intended to be visible.
#
# =============================================================================
# IMPORTANT - Static export + private keys
# =============================================================================
#
# This site is built with `output: "export"` (see next.config.ts). The build
# produces static HTML in /out and is deployed to Cloudflare Pages. There is
# no Next.js server runtime at request time. That means private GHL API
# calls cannot run "on the server" via a Next.js route handler in production.
#
# To use a private GHL key safely, route the call through a backend layer:
#   - Cloudflare Pages Functions (functions/api/*.ts)
#   - Cloudflare Worker (separate worker, same account)
#   - GHL inbound webhook (form -> GHL hosted endpoint)
#   - External automation tool (Zapier, Make, n8n) acting as the broker
#
# Calling api.gohighlevel.com directly from a React component (fetch from
# the browser) with a private key is NEVER acceptable - the key would ship
# inside the JS bundle.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Private (server-side only) - never expose to the browser.
# Used by Cloudflare Pages Functions / Workers / external automation.
# -----------------------------------------------------------------------------

# GoHighLevel private API key (Bearer token for v1, or Private Integration
# token for v2). Treat as a password. Rotate if it ever leaks.
GHL_API_KEY=

# GHL Location (sub-account) ID. Pairs with GHL_API_KEY to scope API calls
# to the correct sub-account.
GHL_LOCATION_ID=

# GHL Form ID for the primary quote form. Used by backend code when
# programmatically submitting form data to GHL or looking up submissions.
GHL_FORM_ID=

# GHL Calendar ID for the booking calendar (when a calendar is wired in).
# Used by backend code for slot lookups or appointment creation.
GHL_CALENDAR_ID=

# GHL inbound webhook URL. The browser MAY POST to this URL directly because
# GHL inbound webhooks are designed to receive unauthenticated public POSTs
# (the URL itself is the credential, and GHL applies rate limiting and bot
# defenses). Even so, prefer keeping the webhook URL server-side and
# proxying through a Pages Function so the URL is not visible in client
# JavaScript and can be rotated without redeploying the frontend.
GHL_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Public (NEXT_PUBLIC_*) - intentionally exposed to the browser bundle.
# Only put values here that are SAFE to be visible in client JavaScript.
# -----------------------------------------------------------------------------

# Public URL of the GHL-hosted form embed (iframe src or redirect target).
# GHL form embed URLs are intended to be public, so NEXT_PUBLIC_ is fine.
NEXT_PUBLIC_GHL_FORM_URL=

# Public URL of the GHL-hosted calendar embed (iframe src or redirect target).
# GHL calendar embed URLs are intended to be public, so NEXT_PUBLIC_ is fine.
NEXT_PUBLIC_GHL_CALENDAR_URL=
